{
  "name": "@karinmelissa/ds-checkbox",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Checkbox component",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build:types": "tsc -p tsconfig.build.json",
    "build:compile": "library \"src/**/*\"",
    "build:exports": "exports \"lib/**/*\" \"types/**/*\" --wrappers",
    "build": "npm run build:types && npm run build:compile && npm run build:exports",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@atomico/hooks": "^4.0.0",
    "atomico": "^1.79.2"
  },
  "devDependencies": {
    "@atomico/exports": "^1.13.2",
    "@atomico/tsconfig": "^1.1.2",
    "@atomico/vite": "^2.7.0",
    "@vitest/coverage-v8": "^3.1.4",
    "jsdom": "^26.1.0",
    "typescript": "^4.8.4",
    "vite": "latest",
    "vitest": "^3.1.4"
  },
  "peerDependencies": {
    "@atomico/react": "*",
    "@atomico/vue": "*"
  },
  "peerDependenciesMeta": {
    "@atomico/react": {
      "optional": true
    },
    "@atomico/vue": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./react": {
      "types": "./wrapper/react.d.ts",
      "default": "./wrapper/react.js"
    },
    "./vue": {
      "types": "./wrapper/vue.d.ts",
      "default": "./wrapper/vue.js"
    },
    "./ds-checkbox": {
      "default": "./lib/ds-checkbox.js"
    },
    "./components/Checkbox": {
      "types": "./types/components/Checkbox.d.ts",
      "default": "./lib/components/Checkbox.js"
    },
    "./components/Checkbox.type": {
      "types": "./types/components/Checkbox.type.d.ts",
      "default": "./lib/components/Checkbox.type.js"
    },
    "./css/checkbox.style": {
      "types": "./types/css/checkbox.style.d.ts",
      "default": "./lib/css/checkbox.style.js"
    },
    "./preact": {
      "types": "./wrapper/preact.d.ts",
      "default": "./wrapper/preact.js"
    },
    "./index2": {
      "default": "./lib/index2.js"
    },
    "./index2/react": {
      "types": "./wrapper/index2/react.d.ts",
      "default": "./wrapper/index2/react.js"
    },
    "./index2/preact": {
      "types": "./wrapper/index2/preact.d.ts",
      "default": "./wrapper/index2/preact.js"
    },
    "./index2/vue": {
      "types": "./wrapper/index2/vue.d.ts",
      "default": "./wrapper/index2/vue.js"
    }
  },
  "types": "types/index.d.ts",
  "typesVersions": {
    "*": {
      "components/Checkbox": [
        "types/components/Checkbox.d.ts"
      ],
      "components/Checkbox.spec": [
        "types/components/Checkbox.spec.d.ts"
      ],
      "components/Checkbox.type": [
        "types/components/Checkbox.type.d.ts"
      ],
      "css/checkbox.style": [
        "types/css/checkbox.style.d.ts"
      ],
      "react": [
        "wrapper/react.d.ts"
      ],
      "preact": [
        "wrapper/preact.d.ts"
      ],
      "vue": [
        "wrapper/vue.d.ts"
      ],
      "index2/react": [
        "wrapper/index2/react.d.ts"
      ],
      "index2/preact": [
        "wrapper/index2/preact.d.ts"
      ],
      "index2/vue": [
        "wrapper/index2/vue.d.ts"
      ]
    }
  }
}
